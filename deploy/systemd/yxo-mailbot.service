[Unit]
Description=YXO MailBot Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=yxo
Group=yxo
WorkingDirectory=/opt/yxo/mailbots
Environment=PYTHONPATH=/opt/yxo/mailbots
Environment=YXO_ROOT=/opt/yxo
Environment=YXO_DATA_DIR=/var/lib/yxo
Environment=YXO_CONFIG_DIR=/etc/yxo
Environment=YXO_LOG_DIR=/var/log/yxo
ExecStart=/opt/yxo/venv/bin/python -m mailbots.mailbot_serve --live
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yxo-mailbot

# 安全设置
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yxo /var/log/yxo /etc/yxo

[Install]
WantedBy=multi-user.target