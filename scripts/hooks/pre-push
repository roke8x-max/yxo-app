#!/bin/sh
#
# pre-push hook —— 拦截直接推送到 main 的操作
#
# 为什么需要它：
#   GitHub 免费版的私有仓库开不了服务端分支保护，
#   所以用本地 hook 达到同样效果：main 只能通过 Pull Request 合入。
#
#   2026-10-04 修正：本文件原先提示"改推 dev"，但 dev 已于 2026-09-18 废弃，
#   属于误导性指引，已改为指向 WORKFLOW.md 的临时分支流程。
#
# 安装：在仓库根目录执行
#   powershell -ExecutionPolicy Bypass -File scripts\install-hooks.ps1
#

while read -r local_ref local_sha remote_ref remote_sha
do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo ""
		echo "  ======================================================"
		echo "   已拦截：不允许直接 push 到 main"
		echo "  ======================================================"
		echo ""
		echo "  main 是生产分支，只能经 Pull Request 合入（Squash and merge）。"
		echo ""
		echo "  正确做法："
		echo "    1) 从最新 main 拉一条扁平命名的临时分支（见 WORKFLOW.md §3）"
		echo "    2) git push origin <你的临时分支名>"
		echo "    3) 到 GitHub 网页开 PR：base=main ← compare=<你的临时分支名>"
		echo "    4) Squash and merge 合并，合并后删除分支"
		echo ""
		echo "  只有生产事故抢修时才允许绕过："
		echo "    git push --no-verify origin main"
		echo "  绕过后必须立刻报备，并当天补记原因。"
		echo ""
		exit 1
	fi
done

exit 0
